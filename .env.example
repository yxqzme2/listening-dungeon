# The Listening Dungeon: settings for docker-compose.yml
# Copy this file to .env and fill it in. (tools/setup-builder.html can write it for you.)

# ── Audiobookshelf ───────────────────────────────────────────────────────
# Your ABS server, as the containers can reach it (not "localhost": that's the container itself).
ABS_URL=http://192.168.1.50:13378
# API token of an ABS admin user (ABS: Settings → Users → your admin user → API token). Required.
ABS_TOKEN=
# Optional: each player's own token, as username:token pairs. Unlocks their
# personal playlists ("add this series to my playlist") and per-user extras.
ABS_TOKENS=

# ── Players ──────────────────────────────────────────────────────────────
# Comma-separated ABS usernames who can play. Empty = every ABS user.
ALLOWED_USERS=
# Friendlier display names: absusername:Name,absusername2:Name 2
USER_ALIASES=

# ── Admin (/admin: monsters, loot, requests, Release Radar) ──────────────
# Required. Pick your own.
ADMIN_PASSWORD=
# Any long random text (40+ characters); keeps admin logins working across restarts.
ADMIN_SESSION_SECRET=

# ── Everything else ──────────────────────────────────────────────────────
# Your timezone (the Store restocks at midnight; the December boss's weeks follow it).
TZ=America/New_York
# The port the game is published on.
GAME_PORT=8000
# How often Release Radar checks Audible for new books in your series (hours).
RADAR_CHECK_INTERVAL_HOURS=12
